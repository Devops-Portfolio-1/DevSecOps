    }, {
      "ruleId" : "GHSA-vg7j-7cwx-8wgw",
      "level" : "warning",
      "message" : {
        "text" : "GHSA-vg7j-7cwx-8wgw - Mongoose versions prior to 8.9.5, 7.8.4, and 6.13.6 are vulnerable to improper use of the `$where` operator. This vulnerability arises from the ability of the `$where` clause to execute arbitrary JavaScript code in MongoDB queries, potentially leading to code injection attacks and unauthorized access or manipulation of database data.\n\nNOTE: this issue exists because of an incomplete fix for CVE-2024-53900."
      },
      "partialFingerprints" : {
        "vulnerabilityHash" : "fd1439b43c6fc379f7b009828e9c245b"
      },
      "locations" : [ {
        "physicalLocation" : {
          "artifactLocation" : {
            "uri" : "file:///var/jenkins_home/workspace/DevSecOps_feat_enabling-ci-cd/package-lock.json?/mongoose:5.13.20",
            "index" : 2031
